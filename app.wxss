/* app.wxss - 全局样式 */
page {
  background: #F6F6F6;
  font-size: 28rpx;
  color: #333333;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', 'PingFang SC',
    'Microsoft YaHei', sans-serif;
}

/* 通用容器 */
.container {
  padding: 20rpx;
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #FF8A4C, #FF6A3D);
  color: #FFFFFF;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  text-align: center;
  line-height: 88rpx;
  height: 88rpx;
}

.btn-primary::after {
  border: none;
}

.btn-disabled {
  background: #D8D8D8 !important;
  color: #FFFFFF !important;
}

/* 价格 */
.price {
  color: #FF4D2E;
  font-weight: 700;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 36rpx;
}

.price-original {
  color: #B0B0B0;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 10rpx;
  font-weight: 400;
}

/* 标签 */
.tag {
  display: inline-block;
  font-size: 20rpx;
  color: #FF6A3D;
  background: rgba(255, 106, 61, 0.12);
  border: 1rpx solid rgba(255, 106, 61, 0.4);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 8rpx;
}

.tag-hot {
  color: #FF3B30;
  background: rgba(255, 59, 48, 0.1);
  border-color: rgba(255, 59, 48, 0.35);
}

.tag-new {
  color: #34C759;
  background: rgba(52, 199, 89, 0.1);
  border-color: rgba(52, 199, 89, 0.35);
}

/* 空状态 */
.empty {
  text-align: center;
  color: #B0B0B0;
  padding: 120rpx 0;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 88rpx;
  display: block;
  margin-bottom: 20rpx;
}
