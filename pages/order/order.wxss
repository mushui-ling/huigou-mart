/* pages/order/order.wxss - 结算下单样式 */
.page {
  padding-bottom: 150rpx;
}

.card {
  margin: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 140rpx;
  font-size: 26rpx;
  color: #555555;
}

.form-input {
  flex: 1;
  font-size: 26rpx;
}

.order-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.order-img {
  width: 100rpx;
  height: 100rpx;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.order-info {
  flex: 1;
  margin-left: 16rpx;
}

.order-name {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.order-price {
  font-size: 22rpx;
  color: #999999;
}

.order-subtotal {
  font-size: 26rpx;
  font-weight: 600;
}

.total-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #555555;
}

.total-final {
  border-top: 1rpx solid #F2F2F2;
  margin-top: 8rpx;
  padding-top: 20rpx;
  font-weight: 600;
  color: #333333;
}

.submit-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.submit-total {
  flex: 1;
  display: flex;
  align-items: baseline;
  font-size: 26rpx;
}

.submit-btn {
  background: linear-gradient(135deg, #FF8A4C, #FF6A3D);
  color: #FFFFFF;
  border-radius: 44rpx;
  padding: 0 56rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: 30rpx;
  font-weight: 600;
}
