/* pages/detail/detail.wxss - 商品详情样式 */
.page {
  padding-bottom: 140rpx;
}

.hero {
  height: 560rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.hero-emoji {
  font-size: 220rpx;
}

.hero-tags {
  position: absolute;
  left: 30rpx;
  top: 30rpx;
}

.tag-white {
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.2);
  border-color: rgba(255, 255, 255, 0.6);
}

.info-card {
  margin: 20rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
}

.sales {
  margin-left: auto;
  font-size: 24rpx;
  color: #999999;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  margin: 16rpx 0 8rpx;
  line-height: 1.4;
}

.sub {
  font-size: 24rpx;
  color: #999999;
}

.desc-card {
  margin: 0 20rpx 20rpx;
}

.desc-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: 26rpx;
  color: #555555;
  line-height: 1.7;
}

.desc-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #999999;
  border-top: 1rpx solid #F2F2F2;
  padding-top: 16rpx;
}

.cart-tip {
  margin: 0 20rpx 20rpx;
  background: #FFF7E6;
  border: 1rpx solid #FFE3A3;
  border-radius: 12rpx;
  padding: 20rpx;
  color: #B87A00;
  font-size: 26rpx;
  text-align: center;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.stepper {
  display: flex;
  align-items: center;
  margin-right: 20rpx;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #F2F2F2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #333333;
}

.stepper-disabled {
  color: #CCCCCC;
}

.stepper-num {
  min-width: 64rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
}

.action-add {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #FFB84D;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 44rpx 0 0 44rpx;
}

.action-buy {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: linear-gradient(135deg, #FF8A4C, #FF6A3D);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 0 44rpx 44rpx 0;
}
