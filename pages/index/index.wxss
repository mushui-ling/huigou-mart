/* pages/index/index.wxss - 首页样式 */
.page {
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 20rpx;
  background: #FF6A3D;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 40rpx;
  height: 68rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-clear {
  color: #B0B0B0;
  font-size: 28rpx;
  padding: 0 6rpx;
}

.ai-entry {
  display: flex;
  align-items: center;
  color: #FFFFFF;
  font-size: 26rpx;
  margin-left: 20rpx;
  background: rgba(255, 255, 255, 0.18);
  border-radius: 34rpx;
  padding: 10rpx 18rpx;
}

.ai-icon {
  font-size: 28rpx;
  margin-right: 6rpx;
}

/* 搜索结果 */
.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 24rpx 8rpx;
  font-size: 28rpx;
  color: #666666;
}

.result-back {
  color: #FF6A3D;
  font-size: 26rpx;
}

/* 轮播 */
.banner {
  height: 300rpx;
  margin: 20rpx;
}

.banner-item {
  height: 100%;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 48rpx;
  color: #FFFFFF;
}

.banner-title {
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.banner-sub {
  font-size: 26rpx;
  opacity: 0.9;
}

/* 分类导航 */
.category-nav {
  display: flex;
  flex-wrap: wrap;
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 0 20rpx 20rpx;
  padding: 24rpx 12rpx;
}

.category-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.category-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #FFF3EC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  margin-bottom: 10rpx;
}

.category-name {
  font-size: 24rpx;
  color: #444444;
}

/* 分区 */
.section {
  margin: 0 20rpx 20rpx;
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx 20rpx;
}

.section-title-text {
  font-size: 32rpx;
  font-weight: 700;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

/* 商品网格 */
.product-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.product-card {
  width: 344rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-bottom: 20rpx;
  box-sizing: border-box;
}

.product-img {
  height: 240rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 96rpx;
  margin-bottom: 14rpx;
}

.product-name {
  font-size: 26rpx;
  color: #333333;
  line-height: 1.4;
  height: 72rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.product-tags {
  margin: 8rpx 0;
  min-height: 30rpx;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  margin-top: 6rpx;
}

.product-unit {
  font-size: 22rpx;
  color: #B0B0B0;
  margin-left: 6rpx;
}

/* 新品横滑 */
.new-scroll {
  white-space: nowrap;
}

.new-list {
  display: inline-flex;
}

.new-card {
  width: 260rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 16rpx;
  margin-right: 20rpx;
  display: inline-block;
}

.new-img {
  height: 180rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  margin-bottom: 12rpx;
}

.new-name {
  font-size: 24rpx;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 8rpx;
}
