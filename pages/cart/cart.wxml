<!-- pages/cart/cart.wxml - 购物车 -->
<view class="page">

  <!-- 空购物车 -->
  <view wx:if="{{cart.length === 0}}" class="empty cart-empty">
    <text class="empty-icon">🛒</text>
    <text>购物车还是空的，去挑点好物吧～</text>
    <view class="btn-primary go-shopping" bindtap="goShopping">去逛逛</view>
  </view>

  <!-- 购物车列表 -->
  <block wx:else>
    <view class="cart-list">
      <view wx:for="{{cart}}" wx:key="productId" class="cart-item">
        <view
          class="check {{item.checked ? 'check-on' : ''}}"
          data-index="{{index}}"
          bindtap="toggleCheck"
        >{{item.checked ? '✓' : ''}}</view>
        <view class="item-img" style="background: {{item.color}};" data-id="{{item.productId}}" bindtap="goDetail">{{item.emoji}}</view>
        <view class="item-info" data-id="{{item.productId}}" bindtap="goDetail">
          <view class="item-name">{{item.name}}</view>
          <view class="item-price-row">
            <text class="price"><text class="price-symbol">¥</text><text class="price-num">{{item.price}}</text></text>
            <text class="item-unit">/{{item.unit}}</text>
          </view>
        </view>
        <view class="item-right">
          <view class="stepper">
            <view class="stepper-btn {{item.count <= 1 ? 'stepper-disabled' : ''}}" data-index="{{index}}" catchtap="decrease">−</view>
            <view class="stepper-num">{{item.count}}</view>
            <view class="stepper-btn" data-index="{{index}}" catchtap="increase">＋</view>
          </view>
          <view class="remove" data-index="{{index}}" catchtap="removeItem">删除</view>
        </view>
      </view>
    </view>
  </block>

  <!-- 底部结算栏 -->
  <view wx:if="{{cart.length > 0}}" class="checkout-bar">
    <view class="check-all" bindtap="toggleAll">
      <view class="check {{allChecked ? 'check-on' : ''}}">{{allChecked ? '✓' : ''}}</view>
      <text>全选</text>
    </view>
    <view class="checkout-total">
      <text>合计：</text>
      <text class="price"><text class="price-symbol">¥</text><text class="price-num total-num">{{totalPrice}}</text></text>
      <text class="total-tip">共{{totalCount}}件</text>
    </view>
    <view class="checkout-btn" bindtap="checkout">去结算({{totalCount}})</view>
  </view>
</view>
